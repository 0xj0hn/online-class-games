# ── Frontend ──────────────────────────────────────────────────────────────────
# Origin of the leaderboard API, or "/" for same-origin (self-hosted default).
#
#   "/"             → calls /api/leaderboard on the same host. This is what the
#                     Docker Compose setup uses: one Node process serves both the
#                     app and the API, so there is no CORS and nothing to change.
#   https://…       → a separate API origin (Vercel, or a second host).
#   empty           → practice works fully offline, no leaderboard.
VITE_API_URL=/

# Public hostname you serve on, used by docker-compose for automatic HTTPS.
# Only needed for `docker compose up`. Point a DNS A record at the server first.
DOMAIN=

# ── API (serverless function in api/leaderboard.ts) ──────────────────────────
# Only needed by the serverless function. Vercel reads these from
# Project → Settings → Environment Variables, NOT from this file.
# This file is a local-dev reference only.

# Comma-separated list of origins allowed to call the API (CORS).
# `*` allows everyone, which is fine for this public classroom board since the
# server recomputes every score. Restrict it if you want to lock it to your class.
ALLOWED_ORIGINS=*

# Managed libSQL database (Turso), e.g. libsql://my-db-you.turso.io
TURSO_DATABASE_URL=

# Auth token from `turso db tokens create <db-name>`
TURSO_AUTH_TOKEN=

# ── Pack editing (self-hosted only) ───────────────────────────────────────────
# Shared secret required to save question packs in /admin. Pick anything long
# and random, e.g. `openssl rand -base64 24`. You type it once in the admin
# page and the browser remembers it.
#
# Leave empty and the app still runs, but saving packs is refused with a clear
# message in the admin page. Not used by the Vercel serverless setup — set it
# there as an environment variable instead.
ADMIN_KEY=